/**
 * Core Philosophy: This ruleset is designed for a public-facing website that collects anonymous data and a private admin dashboard. The security goals are:
 * 1. Allow the public to read specific data (AI assistant state).
 * 2. Allow anonymous write-only submission of data (visits, feedback).
 * 3. Secure the admin dashboard by restricting access to authenticated users with an "admin" role.
 * 4. Protect user profile data, allowing users only to read their own information.
 *
 * Data Structure: Data is organized into top-level collections.
 * - /ai_assistant: Publicly readable state information.
 * - /website_visits: Write-only collection for anonymous traffic.
 * - /users: Stores user profiles and roles, critical for RBAC.
 *
 * Key Security Decisions:
 * - Role-Based Access Control (RBAC): The `/users/{userId}` collection contains a `role` field. This is the source of truth for authorization.
 * - User Profile Security: Users can only read their own profile document (`/users/{userId}`). No client is allowed to write to the `users` collection to prevent privilege escalation. Roles must be assigned via the Firebase Console or a trusted backend.
 * - Public Read-Only Data: The `/ai_assistant` collection is readable by anyone.
 * - Anonymous Write-Once Collections: `/website_visits` and its subcollections are "write-only" for anonymous clients to protect privacy.
 * - Default Deny: All operations that are not explicitly granted are denied.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //-------------------------------------------------------------------------
    // Helper Functions
    //-------------------------------------------------------------------------

    /**
     * Checks if a user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Verifies that the parent website_visits document exists.
     */
    function isParentVisitExists(visitId) {
      return exists(/databases/$(database)/documents/website_visits/$(visitId));
    }

    /**
     * Ensures that the feedback document contains a 'visitId' field
     * that matches the parent document's ID in the path.
     */
    function feedbackLinksToParentVisit(visitId) {
      return request.resource.data.visitId == visitId;
    }


    //-------------------------------------------------------------------------
    // Collection Rules
    //-------------------------------------------------------------------------

    /**
     * @description Controls access to user profile data, including roles.
     * @path /users/{userId}
     * @allow (read) A user can only read their own profile.
     * @deny (list, create, update, delete) No client can list users or modify any user profile. This is a critical security measure to prevent users from changing their own roles.
     * @principle Enforces strict data ownership and prevents privilege escalation.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      // WARNING: This rule allows any new user to assign themselves the 'admin' role upon signup.
      // This is insecure for most production environments.
      // For a secure setup, restrict role assignment to a trusted backend (e.g., Cloud Function)
      // or manage roles manually in the Firebase Console.
      allow create: if request.auth.uid == userId && request.resource.data.role in ['admin', 'user'];
      allow update: if false;
      allow delete: if false;
    }
    
    /**
     * @description Controls access to the AI assistant's public state.
     * @path /ai_assistant/{assistantId}
     * @allow (get, list) Any user, signed-in or not, can read the AI's state.
     * @deny (create, update, delete) No user can modify the AI's state from the client.
     * @principle Makes application state data public while preventing client-side modification.
     */
    match /ai_assistant/{assistantId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages anonymous website visit data.
     * @path /website_visits/{visitId}
     * @allow (create) Any client can create a new website visit document.
     * @deny (get, list, update, delete) No client can read, modify, or delete visit data to protect privacy and data integrity.
     * @principle Implements a "write-only" log for anonymous data submission.
     */
    match /website_visits/{visitId} {
      allow get: if false;
      allow list: if false;
      allow create: if true;
      allow update: if false;
      allow delete: if false;

      /**
       * @description Manages anonymous CTO feedback associated with a website visit.
       * @path /website_visits/{visitId}/cto_feedback/{feedbackId}
       * @allow (create) An anonymous user can submit feedback, but only if the parent visit exists and the feedback's internal visitId matches the path.
       * @deny (get, list, update, delete) No client can read, modify, or delete submitted feedback.
       * @principle Enforces relational integrity and a secure "write-only" model for subcollections.
       */
      match /cto_feedback/{feedbackId} {
        allow get: if false;
        allow list: if false;
        allow create: if isParentVisitExists(visitId) && feedbackLinksToParentVisit(visitId);
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
