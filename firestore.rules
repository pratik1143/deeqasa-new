
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset implements a strict user-ownership model.
     * Users can only access their own profile data and the quotations they created.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    /**
     * @description Checks if the request is from an authenticated user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the provided UID matches the authenticated user's UID.
     * @param userId The UID to verify against the current session.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the User collection.
     * Users can only read or create their own profile document.
     */
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
    }

    /**
     * @description Rules for the Quotation collection.
     * Enforces that users can only manage quotations where they are the creator.
     */
    match /quotations/{quotationId} {
      
      /**
       * @description Allow individual document retrieval if the user is the owner.
       * The 'resource == null' check handles existence checks without leaking data.
       */
      allow get: if isSignedIn() && (resource == null || resource.data.createdBy == request.auth.uid);

      /**
       * @description Allow collection queries (list) if the user filters by their own UID.
       * This is strictly required for the query coverage check in Firestore.
       */
      allow list: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      /**
       * @description Ensure that when a quotation is created, the 'createdBy' field 
       * correctly identifies the authenticated user.
       */
      allow create: if isSignedIn() 
                    && request.resource.data.createdBy == request.auth.uid;

      /**
       * @description Allow updates/deletes only by the owner.
       */
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // --- DEFAULT DENY ---
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
