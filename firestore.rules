rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description 🛡️ ADMIN-ONLY ACCESS CONTROL
     * This application is a single-tenant administrative system.
     * Only the authorized administrator email has access to system data.
     */
    match /{document=**} {
      allow read, write: if request.auth != null 
        && request.auth.token.email == "deeqasa@admin.in";
    }
  }
}