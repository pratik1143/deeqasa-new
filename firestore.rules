
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset implements a strict user-ownership model.
     * Users can only access their own profile data and the quotations they created.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    /**
     * @description Checks if the request is from an authenticated user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the provided UID matches the authenticated user's UID.
     * @param userId The UID to verify against the current session.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Verifies ownership of an existing document before modification or deletion.
     * @param userId The UID stored in the existing document's ownership field.
     */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the User collection.
     * Users can only read or create their own profile document.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      // Updates are allowed only by the owner
      allow update: if isOwner(userId);
    }

    /**
     * @description Rules for the Quotation collection.
     * Enforces that users can only manage quotations where they are the creator.
     */
    match /quotations/{quotationId} {
      
      // Allow user to retrieve or list specific quotations if they are the creator.
      allow get, list: if isOwner(resource.data.createdBy);

      // Ensure that when a quotation is created, the 'createdBy' field 
      // correctly identifies the authenticated user.
      allow create: if isSignedIn() 
                    && request.resource.data.createdBy == request.auth.uid;

      // Allow updates only by the owner and prevent transferring ownership.
      allow update: if isExistingOwner(resource.data.createdBy) 
                    && request.resource.data.createdBy == resource.data.createdBy;

      // Allow deletion only by the owner.
      allow delete: if isExistingOwner(resource.data.createdBy);
    }

    // --- DEFAULT DENY ---
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
