
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if user has admin privileges.
     * Includes an explicit email whitelist for high-security modules.
     */
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'deeqasa@admin.in' ||
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
    }

    match /roles_admin/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
    
    match /quotations/{quotationId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.quotationId == quotationId;
      allow update: if isAdmin() && resource != null && request.resource.data.quotationId == resource.data.quotationId;
      allow delete: if isAdmin() && resource != null;
    }

    match /expenses/{expenseId} {
      allow get, list, create, update, delete: if isAdmin();
    }
  }
}
