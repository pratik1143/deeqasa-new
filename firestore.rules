rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the system admin by email.
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "deeqasa@admin.in";
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the User collection.
     * Users can access their own profile, or admin can access all.
     */
    match /users/{userId} {
      allow read, create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    /**
     * @description Rules for the Quotation collection.
     * Enforces admin overrides and user-ownership filters.
     */
    match /quotations/{quotationId} {
      
      /**
       * @description Allow read (get and list) if the user is an admin or the creator.
       * Firestore query filters must match this ownership check.
       */
      allow read: if isSignedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);

      /**
       * @description Allow creation if the user is an admin or is correctly identifying themselves as creator.
       */
      allow create: if isSignedIn() && (isAdmin() || request.resource.data.createdBy == request.auth.uid);

      /**
       * @description Allow updates and deletions only by the owner or admin.
       */
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }

    // --- DEFAULT DENY ---
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
