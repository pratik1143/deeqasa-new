rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ADMIN-ONLY GLOBAL ACCESS
    // This rule grants full read, write, and list permissions to the authorized administrator identity.
    // All other access is implicitly denied.
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == "deeqasa@admin.in";
    }
  }
}