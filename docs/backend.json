{
  "entities": {
    "Quotation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Quotation",
      "type": "object",
      "description": "Administrative quotation records for HP Enterprise solutions.",
      "properties": {
        "quotationId": {
          "type": "string",
          "description": "Unique identifier for the Quotation entity."
        },
        "clientDetails": {
          "type": "string",
          "description": "JSON string containing client identity and location."
        },
        "products": {
          "type": "string",
          "description": "JSON string representing the bill of materials."
        },
        "pricing": {
          "type": "string",
          "description": "JSON string representing unit pricing."
        },
        "totals": {
          "type": "string",
          "description": "JSON string representing commercial totals."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 creation timestamp.",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the administrator who generated the record."
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "ARCHIVED"],
          "description": "Active pipeline status."
        },
        "subject": {
          "type": "string",
          "description": "Quotation subject line."
        }
      },
      "required": [
        "quotationId",
        "clientDetails",
        "products",
        "pricing",
        "totals",
        "createdAt",
        "createdBy",
        "status"
      ]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Administrator profile identity.",
      "properties": {
        "email": {
          "type": "string",
          "description": "Verified administrative email."
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "System access level."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Profile initialization timestamp."
        }
      },
      "required": [
        "email",
        "role",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/quotations/{quotationId}": {
      "schema": {
        "$ref": "#/backend/entities/Quotation"
      },
      "description": "Global administrative quotation repository. Restricted to deeqasa@admin.in."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/UserProfile"
      },
      "description": "Administrative profile data."
    }
  }
}