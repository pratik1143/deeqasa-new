{
  "entities": {
    "Quotation": {
      "title": "Quotation",
      "description": "Enterprise HP solution records. Managed exclusively by deeqasa@admin.in.",
      "type": "object",
      "properties": {
        "quotationId": { "type": "string" },
        "clientDetails": { "type": "string" },
        "products": { "type": "string" },
        "pricing": { "type": "string" },
        "totals": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "ARCHIVED"] },
        "subject": { "type": "string" }
      },
      "required": ["quotationId", "clientDetails", "products", "pricing", "totals", "createdAt", "createdBy", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Administrator identity profile.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/quotations/{quotationId}": {
      "schema": { "$ref": "#/backend/entities/Quotation" },
      "description": "Master quotation repository. Restricted to deeqasa@admin.in."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Administrator profiles."
    }
  }
}